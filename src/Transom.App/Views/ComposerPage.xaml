<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Transom.App.Views.ComposerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Transom.App.Converters"
    xmlns:viewmodels="using:Transom.App.ViewModels"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
        <converters:UrlToImageSourceConverter x:Key="UrlToImageSourceConverter" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    </Page.Resources>
    <Grid Padding="24" AllowDrop="True" DragOver="ComposerRoot_DragOver" Drop="ComposerRoot_Drop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="PublishAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="TitleBox"
            Grid.Row="0"
            Margin="0,0,0,8"
            PlaceholderText="Title"
            AutomationProperties.Name="Post title"
            Text="{x:Bind ViewModel.Title, Mode=TwoWay}"
            Visibility="{x:Bind ViewModel.ShowTitleField, Mode=OneWay}"
            PreviewKeyDown="ComposerTextBox_PreviewKeyDown" />

        <TextBox
            x:Name="BodyBox"
            Grid.Row="1"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            PlaceholderText="What's on your mind?"
            AutomationProperties.Name="Post text"
            Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PreviewKeyDown="ComposerTextBox_PreviewKeyDown"
            Paste="BodyBox_Paste" />

        <ScrollViewer
            Grid.Row="2"
            Margin="0,8,0,0"
            Padding="4,0,4,8"
            HorizontalScrollMode="Auto"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollMode="Disabled"
            Visibility="{x:Bind ViewModel.Images.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Images}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:ComposerImageViewModel">
                        <Grid Width="180" AutomationProperties.Name="{x:Bind FileName}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Image
                                Grid.Row="0"
                                Source="{x:Bind LocalFileUri, Converter={StaticResource UrlToImageSourceConverter}}"
                                Stretch="UniformToFill" />
                            <ProgressRing Grid.Row="0" IsActive="{x:Bind IsUploading, Mode=OneWay}" Width="24" Height="24" />
                            <Button
                                Grid.Row="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Padding="2"
                                MinWidth="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Visibility="{x:Bind ShowAltTextWarning, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind AltTextAutomationName, Mode=OneWay}"
                                ToolTipService.ToolTip="Add alt text"
                                Tag="{x:Bind}"
                                Click="EditAltTextButton_Click">
                                <FontIcon Glyph="&#xE783;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </Button>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Padding="4" MinWidth="0" Content="&#xE76B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" AutomationProperties.Name="Move left" Command="{x:Bind MoveLeftCommand}" />
                                <Button Padding="4" MinWidth="0" Content="&#xE76C;" FontFamily="{ThemeResource SymbolThemeFontFamily}" AutomationProperties.Name="Move right" Command="{x:Bind MoveRightCommand}" />
                                <Button Padding="4" MinWidth="0" Content="Alt" AutomationProperties.Name="{x:Bind AltTextAutomationName, Mode=OneWay}" Tag="{x:Bind}" Click="EditAltTextButton_Click" />
                                <Button Padding="4" MinWidth="0" Content="Retry" AutomationProperties.Name="Retry upload" Command="{x:Bind RetryCommand}" Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                                <Button Padding="4" MinWidth="0" Content="&#xE711;" FontFamily="{ThemeResource SymbolThemeFontFamily}" AutomationProperties.Name="Remove image" Command="{x:Bind RemoveCommand}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <TextBlock
            Grid.Row="3"
            Margin="0,8,0,8"
            HorizontalAlignment="Right"
            Opacity="0.7"
            Text="{x:Bind ViewModel.CharacterCountDisplay, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ViewModel.CharacterCountAutomationName, Mode=OneWay}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
            <Button Content="Add image" AutomationProperties.Name="Add image" Click="AddImageButton_Click" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12">
            <Button
                Content="Publish"
                AutomationProperties.Name="Publish post"
                Command="{x:Bind ViewModel.PublishCommand}"
                ToolTipService.ToolTip="Publish (Ctrl+Enter)" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsPublishing, Mode=OneWay}" Width="20" Height="20" />
            <TextBlock
                Text="Sign in under Settings to publish"
                VerticalAlignment="Center"
                Opacity="0.7"
                Visibility="{x:Bind ViewModel.ShowSignInHint, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,16,0,0" Spacing="8">
            <InfoBar
                IsOpen="{x:Bind ViewModel.AddImageErrorMessage, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                Severity="Informational"
                Title="Couldn't add image"
                Message="{x:Bind ViewModel.AddImageErrorMessage, Mode=OneWay}" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.PublishedUrl, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                Severity="Success"
                Title="{x:Bind ViewModel.PublishSuccessTitle, Mode=OneWay}">
                <InfoBar.Content>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.HasPublishedUri, Mode=OneWay}">
                        <HyperlinkButton
                            Content="{x:Bind ViewModel.PublishedUrl, Mode=OneWay}"
                            NavigateUri="{x:Bind ViewModel.PublishedUri, Mode=OneWay}"
                            AutomationProperties.Name="View post" />
                        <Button
                            Content="Copy link"
                            AutomationProperties.Name="Copy link"
                            Click="CopyLinkButton_Click" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <InfoBar
                IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToBoolConverter}}"
                Severity="Error"
                Title="Couldn't publish"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Retry" AutomationProperties.Name="Retry publish" Command="{x:Bind ViewModel.PublishCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
    </Grid>
</Page>
